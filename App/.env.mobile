# Mobile build — Capacitor
# The backend URL here is used when running with a local dev server.
# For production mobile builds, set this to your cloud backend or leave empty
# to use the bundled local server (if implemented via a Capacitor plugin).
VITE_PLATFORM=capacitor
VITE_API_URL=http://localhost:23816
VITE_WS_URL=ws://localhost:23816
